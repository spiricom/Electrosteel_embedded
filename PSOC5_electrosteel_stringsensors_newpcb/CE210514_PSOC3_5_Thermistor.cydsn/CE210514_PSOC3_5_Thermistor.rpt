    [McSlotId=0]:     MacroCell: Name=\SPIM_3:BSPIM:load_cond\, Mode=(T-Register) @ [UDB=(3,3)][LB=0][MC=0]
        Total # of inputs        : 9
        Total # of product terms : 4
        List of special equations: 
            Clock  = (\SPIM_3:Net_276\) => Global
            Clock Enable: True
        Main Equation            : 4 pterms
        (
              !\SPIM_3:BSPIM:state_2\ * !\SPIM_3:BSPIM:count_4\ * 
              !\SPIM_3:BSPIM:count_3\ * !\SPIM_3:BSPIM:count_2\ * 
              !\SPIM_3:BSPIM:count_1\ * !\SPIM_3:BSPIM:count_0\ * 
              \SPIM_3:BSPIM:load_cond\
            + \SPIM_3:BSPIM:state_2\ * !\SPIM_3:BSPIM:state_1\ * 
              !\SPIM_3:BSPIM:state_0\ * !\SPIM_3:BSPIM:load_cond\
            + \SPIM_3:BSPIM:state_1\ * !\SPIM_3:BSPIM:count_4\ * 
              !\SPIM_3:BSPIM:count_3\ * !\SPIM_3:BSPIM:count_2\ * 
              !\SPIM_3:BSPIM:count_1\ * !\SPIM_3:BSPIM:count_0\ * 
              \SPIM_3:BSPIM:load_cond\
            + \SPIM_3:BSPIM:state_0\ * !\SPIM_3:BSPIM:count_4\ * 
              !\SPIM_3:BSPIM:count_3\ * !\SPIM_3:BSPIM:count_2\ * 
              !\SPIM_3:BSPIM:count_1\ * !\SPIM_3:BSPIM:count_0\ * 
