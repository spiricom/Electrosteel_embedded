            + \SPIM_3:BSPIM:state_2\ * !\SPIM_3:BSPIM:state_0\
            + \SPIM_3:BSPIM:state_1\ * !\SPIM_3:BSPIM:state_0\ * 
              !\SPIM_3:BSPIM:count_4\ * !\SPIM_3:BSPIM:count_3\ * 
              !\SPIM_3:BSPIM:count_2\ * \SPIM_3:BSPIM:count_1\ * 
              !\SPIM_3:BSPIM:count_0\ * !\SPIM_3:BSPIM:ld_ident\
        );
        Output = \SPIM_3:BSPIM:state_1\ (fanout=12)

    MacroCell: Name=\SPIM_3:BSPIM:state_0\, Mode=(T-Register)
        Total # of inputs        : 4
        Total # of product terms : 3
        List of special equations: 
            Clock  = (\SPIM_3:Net_276\) => Global
            Clock Enable: True
        Main Equation            : 3 pterms
        (
              !\SPIM_3:BSPIM:state_2\ * \SPIM_3:BSPIM:state_1\
            + \SPIM_3:BSPIM:state_2\ * !\SPIM_3:BSPIM:state_1\
            + !\SPIM_3:BSPIM:state_1\ * !\SPIM_3:BSPIM:state_0\ * 
              !\SPIM_3:BSPIM:tx_status_1\
        );
        Output = \SPIM_3:BSPIM:state_0\ (fanout=12)

    MacroCell: Name=\SPIM_3:BSPIM:load_cond\, Mode=(T-Register)
        Total # of inputs        : 9
        Total # of product terms : 4
        List of special equations: 
            Clock  = (\SPIM_3:Net_276\) => Global
            Clock Enable: True
        Main Equation            : 4 pterms
        (
              !\SPIM_3:BSPIM:state_2\ * !\SPIM_3:BSPIM:count_4\ * 
              !\SPIM_3:BSPIM:count_3\ * !\SPIM_3:BSPIM:count_2\ * 
              !\SPIM_3:BSPIM:count_1\ * !\SPIM_3:BSPIM:count_0\ * 
              \SPIM_3:BSPIM:load_cond\
            + \SPIM_3:BSPIM:state_2\ * !\SPIM_3:BSPIM:state_1\ * 
              !\SPIM_3:BSPIM:state_0\ * !\SPIM_3:BSPIM:load_cond\
            + \SPIM_3:BSPIM:state_1\ * !\SPIM_3:BSPIM:count_4\ * 
              !\SPIM_3:BSPIM:count_3\ * !\SPIM_3:BSPIM:count_2\ * 
              !\SPIM_3:BSPIM:count_1\ * !\SPIM_3:BSPIM:count_0\ * 
              \SPIM_3:BSPIM:load_cond\
            + \SPIM_3:BSPIM:state_0\ * !\SPIM_3:BSPIM:count_4\ * 
              !\SPIM_3:BSPIM:count_3\ * !\SPIM_3:BSPIM:count_2\ * 
              !\SPIM_3:BSPIM:count_1\ * !\SPIM_3:BSPIM:count_0\ * 
              \SPIM_3:BSPIM:load_cond\
        );
        Output = \SPIM_3:BSPIM:load_cond\ (fanout=1)

    MacroCell: Name=\SPIM_3:BSPIM:ld_ident\, Mode=(T-Register)
        Total # of inputs        : 9
        Total # of product terms : 3
        List of special equations: 
            Clock  = (\SPIM_3:Net_276\) => Global
            Clock Enable: True
        Main Equation            : 3 pterms
        (
              \SPIM_3:BSPIM:state_2\ * !\SPIM_3:BSPIM:state_1\ * 
              !\SPIM_3:BSPIM:state_0\ * !\SPIM_3:BSPIM:ld_ident\
            + \SPIM_3:BSPIM:state_2\ * \SPIM_3:BSPIM:state_1\ * 
              !\SPIM_3:BSPIM:state_0\ * \SPIM_3:BSPIM:ld_ident\
            + \SPIM_3:BSPIM:state_1\ * !\SPIM_3:BSPIM:state_0\ * 
              !\SPIM_3:BSPIM:count_4\ * !\SPIM_3:BSPIM:count_3\ * 
              !\SPIM_3:BSPIM:count_2\ * \SPIM_3:BSPIM:count_1\ * 
              !\SPIM_3:BSPIM:count_0\ * \SPIM_3:BSPIM:ld_ident\
        );
        Output = \SPIM_3:BSPIM:ld_ident\ (fanout=4)

    MacroCell: Name=\SPIM_3:BSPIM:cnt_enable\, Mode=(T-Register)
        Total # of inputs        : 4
        Total # of product terms : 4
        List of special equations: 
            Clock  = (\SPIM_3:Net_276\) => Global
            Clock Enable: True
        Main Equation            : 4 pterms
        (
              !\SPIM_3:BSPIM:state_2\ * !\SPIM_3:BSPIM:state_1\ * 
              !\SPIM_3:BSPIM:state_0\ * \SPIM_3:BSPIM:cnt_enable\
            + !\SPIM_3:BSPIM:state_2\ * \SPIM_3:BSPIM:state_1\ * 
              \SPIM_3:BSPIM:state_0\ * !\SPIM_3:BSPIM:cnt_enable\
            + \SPIM_3:BSPIM:state_2\ * !\SPIM_3:BSPIM:state_1\ * 
              \SPIM_3:BSPIM:state_0\ * \SPIM_3:BSPIM:cnt_enable\
            + \SPIM_3:BSPIM:state_2\ * \SPIM_3:BSPIM:state_1\ * 
              !\SPIM_3:BSPIM:state_0\ * \SPIM_3:BSPIM:cnt_enable\
        );
        Output = \SPIM_3:BSPIM:cnt_enable\ (fanout=2)
    </CYPRESSTAG>
